# OpenAI-compatible chat completions endpoint
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-me
AI_MODEL=replace-with-model-name
# Optional account registration and sign-in via Supabase Auth.
# Use only the project's public anon/publishable key here, never service_role.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional Cloudflare Turnstile bot check. Set both values in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PORT=3000

